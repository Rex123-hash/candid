# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- PayPal (sandbox only) -------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: id of a sandbox webhook pointed at https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Public address of the deployed site, used in printed QR signs (e.g. https://candid.example.com)
SITE_URL=

# --- Gemini (photo reading) -------------------------------------------------
# Recommended: Vertex AI on your Google Cloud project, no API key. Locally run
# `gcloud auth application-default login`; on Cloud Run the service account is used.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Alternative: a Gemini API key from aistudio.google.com
# GEMINI_API_KEY=
# Optional model override
# GEMINI_MODEL=gemini-3.8-flash

# --- Demo stand grower payouts (sandbox personal account emails) -------------
DEMO_GROWER_1_EMAIL=
DEMO_GROWER_2_EMAIL=
DEMO_GROWER_3_EMAIL=

# --- Optional: hosted storage (Upstash Redis). Without these, data is stored in ./.data
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
